@{
    ViewData["Title"] = "Ana Sayfa";
}

<section class="hero text-center px-3 py-5 mb-5">
    <span class="baloncuk b1"></span>
    <span class="baloncuk b2"></span>
    <span class="baloncuk b3"></span>
    <span class="baloncuk b4"></span>

    <div class="icerik py-md-4">
        <div class="display-3 mb-3"><span class="alev">🔥</span></div>
        <h1 class="fw-bold display-5">Çorumgaz Arıza Takip</h1>
        <p class="lead mx-auto mt-3" style="max-width: 640px;">
            Arızanı haritadan işaretle, en yakın ekibimiz otomatik atansın. Takip kodunla durumunu her an öğren.
        </p>

        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mt-4">
            <a asp-controller="Bildirim" asp-action="Create" class="btn btn-light btn-lg px-5 fw-semibold">📝 Arıza Bildir</a>
            <a asp-controller="Bildirim" asp-action="Sorgu" class="btn btn-outline-light btn-lg px-5">🔎 Durum Sorgula</a>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="mt-4">
                <a asp-controller="Ariza" asp-action="Index" class="btn btn-sm btn-outline-light">📋 Personel paneline git →</a>
            </div>
        }
    </div>
</section>

<h4 class="fw-bold text-center mb-4">Nasıl çalışır?</h4>

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 text-center">
            <div class="card-body p-4">
                <span class="adim-numara mb-3">1</span>
                <h5 class="fw-semibold">📍 Konumunu işaretle</h5>
                <p class="text-muted mb-0">Haritaya tıkla ya da "Konumumu Bul" butonunu kullan, adresin otomatik dolsun.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 text-center">
            <div class="card-body p-4">
                <span class="adim-numara mb-3">2</span>
                <h5 class="fw-semibold">👷 Ekip atansın</h5>
                <p class="text-muted mb-0">Sistem sana en yakın ve müsait ekibi otomatik olarak görevlendirir.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 text-center">
            <div class="card-body p-4">
                <span class="adim-numara mb-3">3</span>
                <h5 class="fw-semibold">🔎 Takip et</h5>
                <p class="text-muted mb-0">Takip kodunla ekibin yolda olup olmadığını ve arızanın durumunu gör.</p>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm bg-danger text-white text-center">
    <div class="card-body p-4 p-md-5">
        <h4 class="fw-bold"><span class="alev">🚨</span> Gaz kokusu mu alıyorsun?</h4>
        <p class="mb-3">Elektrik düğmelerine dokunma, ortamı havalandır ve hemen <strong>187</strong> acil hattı ara.</p>
        <a href="tel:187" class="btn btn-light btn-lg px-5 fw-semibold">📞 187'yi Ara</a>
    </div>
</div>