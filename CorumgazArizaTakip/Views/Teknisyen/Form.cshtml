@model CorumgazArizaTakip.Models.Teknisyen
@using System.Globalization

@{
    var baslik = ViewBag.Baslik as string ?? "Ekip Üyesi";
    ViewData["Title"] = baslik;
    var duzenleme = Model.Id != 0;
    var eylem = duzenleme ? "Edit" : "Create";
    var konumVar = Model.Enlem != null && Model.Boylam != null;
    var uzmanliklar = new[] { "Genel", "Gaz kaçağı", "Sayaç arızası", "İç tesisat", "Servis hattı", "Acil müdahale" };
    var bolgeler = new[] { "Merkez", "Kuzey", "Güney", "Doğu", "Batı", "Kuzeydoğu", "Kuzeybatı", "Güneydoğu", "Güneybatı", "Sanayi" };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">👷 @baslik</h3>
        <p class="text-muted mb-0">Bilgileri doldur ve haritadan ekip merkezini işaretle.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary px-4">← Ekiplere dön</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-md-5">
        <form asp-action="@eylem" method="post">
            @if (duzenleme)
            {
                <input type="hidden" asp-for="Id" />
            }
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ad Soyad</label>
                        <input asp-for="AdSoyad" class="form-control" placeholder="Ad Soyad" />
                        <span asp-validation-for="AdSoyad" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Uzmanlık</label>
                        <select asp-for="Uzmanlik" class="form-select">
                            @foreach (var u in uzmanliklar)
                            {
                                <option value="@u">@u</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Bölge</label>
                        <select asp-for="Bolge" class="form-select">
                            @foreach (var b in bolgeler)
                            {
                                <option value="@b">@b</option>
                            }
                        </select>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input asp-for="Musait" class="form-check-input" role="switch" />
                        <label asp-for="Musait" class="form-check-label">Müsait (iş alabilir)</label>
                    </div>

                    <input type="hidden" asp-for="Enlem" id="enlem" />
                    <input type="hidden" asp-for="Boylam" id="boylam" />

                    <div class="alert alert-light border small mb-0" id="konumBilgi">
                        @(konumVar ? "✅ Ekip merkezi seçili. Değiştirmek için haritaya tıkla." : "📍 Ekip merkezi seçilmedi. Haritaya tıklayarak işaretle.")
                    </div>
                </div>

                <div class="col-lg-7">
                    <h6 class="text-uppercase text-muted small fw-semibold mb-3">Ekip Merkezi</h6>
                    <div id="harita" class="rounded-3 shadow-sm border" style="height: 400px;"></div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">İptal</a>
                <button type="submit" class="btn btn-primary px-4">💾 Kaydet</button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const baslangic = @(konumVar
                    ? Html.Raw("[" + Model.Enlem!.Value.ToString(CultureInfo.InvariantCulture) + "," + Model.Boylam!.Value.ToString(CultureInfo.InvariantCulture) + "]")
                : Html.Raw("null"));

        const harita = L.map('harita').setView(baslangic || [40.5503, 34.9564], baslangic ? 15 : 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap'
        }).addTo(harita);

        let isaret = baslangic ? L.marker(baslangic).addTo(harita) : null;

        harita.on('click', e => {
            const lat = e.latlng.lat;
            const lng = e.latlng.lng;

            if (isaret) {
                isaret.setLatLng(e.latlng);
            } else {
                isaret = L.marker(e.latlng).addTo(harita);
            }

            document.getElementById('enlem').value = lat.toFixed(6);
            document.getElementById('boylam').value = lng.toFixed(6);
            document.getElementById('konumBilgi').innerHTML =
                '✅ Ekip merkezi: <strong>' + lat.toFixed(5) + ', ' + lng.toFixed(5) + '</strong>';
        });
    </script>
}