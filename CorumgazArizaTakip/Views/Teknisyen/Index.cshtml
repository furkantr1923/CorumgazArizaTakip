@model List<CorumgazArizaTakip.Controllers.TeknisyenSatir>

@{
    ViewData["Title"] = "Ekipler";
    int musaitSayi = Model.Count(x => x.Teknisyen.Musait);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">👷 Ekipler</h3>
        <p class="text-muted mb-0">@Model.Count ekip üyesi · @musaitSayi müsait · @(Model.Count - musaitSayi) görevde</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-4">➕ Yeni Ekip Üyesi</a>
</div>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success border-0 shadow-sm">✅ @TempData["Mesaj"]</div>
}

@if (Model.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="fs-1">👷</div>
            <h5 class="mt-3">Henüz ekip yok</h5>
            <a asp-action="Create" class="btn btn-primary mt-2">➕ Ekip Üyesi Ekle</a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Ad Soyad</th>
                        <th>Uzmanlık</th>
                        <th>Bölge</th>
                        <th>Durum</th>
                        <th class="text-center">Açık İş</th>
                        <th class="text-center">Çözülen</th>
                        <th>Konum</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        var t = s.Teknisyen;
                        <tr>
                            <td class="ps-4 fw-semibold">@t.AdSoyad</td>
                            <td>@t.Uzmanlik</td>
                            <td>@t.Bolge</td>
                            <td>
                                <form asp-action="DurumDegistir" asp-route-id="@t.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm rounded-pill @(t.Musait ? "btn-success" : "btn-secondary")"
                                            title="Değiştirmek için tıkla">
                                        @(t.Musait ? "✅ Müsait" : "🚗 Görevde")
                                    </button>
                                </form>
                            </td>
                            <td class="text-center"><span class="badge rounded-pill bg-warning text-dark">@s.AcikIs</span></td>
                            <td class="text-center"><span class="badge rounded-pill bg-light text-dark border">@s.Cozulen</span></td>
                            <td class="small text-muted">@(t.Enlem != null ? "📍 Var" : "—")</td>
                            <td class="text-end pe-4 text-nowrap">
                                <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('@t.AdSoyad silinsin mi? Atandığı arızalar boşa çıkar.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}